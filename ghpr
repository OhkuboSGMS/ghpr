#!/usr/bin/env bash
set -euo pipefail

base_dir="${HOME}/work/prs"

# Source repo for self-update. Override with env vars if you fork/rename.
GHPR_REPO="${GHPR_REPO:-OhkuboSGMS/ghpr}"
GHPR_BRANCH="${GHPR_BRANCH:-master}"

print_usage() {
  echo "Usage:" >&2
  echo "  ghpr <pr-number> <owner/repo>" >&2
  echo "  ghpr <github-pr-url>" >&2
  echo "  ghpr create <owner/repo|repo-url> <branch>" >&2
  echo "  ghpr clean [-n|--dry-run] [-y|--yes] [--days <N>]" >&2
  echo "  ghpr update" >&2
  echo "" >&2
  echo "Examples:" >&2
  echo "  ghpr 125 octocat/Hello-World" >&2
  echo "  ghpr https://github.com/octocat/Hello-World/pull/125" >&2
  echo "  ghpr create octocat/Hello-World feature/login" >&2
  echo "  ghpr clean            # remove work dirs whose PR is merged/closed" >&2
  echo "  ghpr clean --dry-run  # list candidates without deleting" >&2
  echo "  ghpr update           # update ghpr itself to the latest version" >&2
}

# Download the latest ghpr + ghpr.sh from GHPR_REPO and replace the installed
# copies in ~/.local/bin. Uses gh for auth, so it works with private repos too.
update_self() {
  if ! command -v gh &>/dev/null; then
    echo "Error: GitHub CLI (gh) is required for 'ghpr update'" >&2
    echo "Install it from: https://cli.github.com/" >&2
    return 1
  fi

  local bindir="${HOME}/.local/bin"
  mkdir -p "$bindir"

  # Stage downloads in a temp dir on the SAME filesystem as bindir so the final
  # swap is an atomic rename (and never corrupts the script that's running now).
  local tmp
  tmp="$(mktemp -d "${bindir}/.ghpr-update.XXXXXX")" || {
    echo "Error: could not create temp dir under ${bindir}" >&2
    return 1
  }
  trap 'rm -rf "$tmp"' RETURN

  echo "==> Updating ghpr from ${GHPR_REPO}@${GHPR_BRANCH}..."

  local f
  for f in ghpr ghpr.sh; do
    if ! gh api "repos/${GHPR_REPO}/contents/${f}?ref=${GHPR_BRANCH}" \
           --jq '.content' 2>/dev/null | base64 -d > "${tmp}/${f}"; then
      echo "Error: failed to download ${f} from ${GHPR_REPO}@${GHPR_BRANCH}" >&2
      return 1
    fi
    if [ ! -s "${tmp}/${f}" ]; then
      echo "Error: downloaded ${f} is empty; aborting (nothing was changed)" >&2
      return 1
    fi
  done

  chmod 0755 "${tmp}/ghpr"
  chmod 0644 "${tmp}/ghpr.sh"
  mv -f "${tmp}/ghpr"    "${bindir}/ghpr"
  mv -f "${tmp}/ghpr.sh" "${bindir}/ghpr.sh"

  echo "==> Updated ${bindir}/ghpr and ${bindir}/ghpr.sh"
  echo "    Reload the wrapper to pick up changes: source ~/.zshrc  (or open a new shell)"
}

# Clone <repo> into the standard work dir and create <branch> off the latest
# default branch (main/master). Mirrors the PR-checkout layout under work/prs.
create_branch() {
  local repo="${1:-}" branch="${2:-}"
  if [ -z "$repo" ] || [ -z "$branch" ]; then
    echo "Usage: ghpr create <owner/repo|repo-url> <branch>" >&2
    return 1
  fi

  if ! command -v gh &>/dev/null; then
    echo "Error: GitHub CLI (gh) is required for 'ghpr create'" >&2
    echo "Install it from: https://cli.github.com/" >&2
    return 1
  fi

  # Normalize the repo argument to an "owner/repo" slug. parse_repo_slug handles
  # https/ssh URLs; a bare "owner/repo" is already in the right form.
  local repo_slug
  repo_slug="$(parse_repo_slug "$repo")"
  [ -z "$repo_slug" ] && repo_slug="${repo%.git}"

  local repo_name="${repo_slug##*/}"
  local branch_dir="${branch//\//-}"          # flatten slashes for the dir name
  local work_dir="${base_dir}/${repo_name}-${branch_dir}"

  mkdir -p "${base_dir}"

  echo "==> Use workdir: ${work_dir}"

  local fresh=0
  CLONE_SEEDED=0
  if [ ! -d "${work_dir}/.git" ]; then
    echo "==> No git repo found in ${work_dir}. Cloning..."
    rm -rf "${work_dir}"
    clone_repo "${repo_slug}" "${work_dir}"
    fresh=1
  else
    echo "==> Existing git repo found in ${work_dir}"
  fi

  cd "${work_dir}"

  # Default branch (main/master). A clone made over the network just now has an
  # authoritative origin/HEAD and is up to date, so it needs neither the API nor
  # a fetch. Otherwise ask the API, and fetch while waiting for the answer.
  local guess default_branch
  guess="$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  guess="${guess#origin/}"
  default_branch="$guess"

  if [ "$fresh" -eq 0 ] || [ "$CLONE_SEEDED" -eq 1 ] || [ -z "$guess" ]; then
    make_tmp
    gh repo view "${repo_slug}" --json defaultBranchRef --jq '.defaultBranchRef.name' \
      >"$GHPR_TMP" 2>/dev/null &
    local info_pid=$!
    local fetched_guess=0
    if [ "$CLONE_SEEDED" -eq 1 ]; then
      echo "==> Fetching origin..."
      gitgh fetch -q --prune origin 2>/dev/null || git fetch --prune origin
    elif [ -n "$guess" ]; then
      echo "==> Fetching latest origin/${guess}..."
      if gitgh fetch -q origin "${guess}" 2>/dev/null; then fetched_guess=1; fi
    fi
    wait "$info_pid" || true
    default_branch="$(cat "$GHPR_TMP" 2>/dev/null || true)"
    [ -z "$default_branch" ] && default_branch="$guess"
    [ -z "$default_branch" ] && default_branch="main"

    [ "$CLONE_SEEDED" -eq 1 ] && seed_finish "$default_branch"

    # Not covered by the fetch above (different name, or that fetch failed).
    if [ "$CLONE_SEEDED" -eq 0 ] && { [ "$default_branch" != "$guess" ] || [ "$fetched_guess" -eq 0 ]; }; then
      echo "==> Fetching latest origin/${default_branch}..."
      git fetch origin "${default_branch}"
    fi
  fi

  if git show-ref --verify --quiet "refs/heads/${branch}"; then
    echo "==> Branch '${branch}' already exists locally; checking it out"
    git checkout "${branch}"
  else
    if git show-ref --verify --quiet "refs/remotes/origin/${branch}"; then
      echo "Note: a remote branch 'origin/${branch}' already exists." >&2
      echo "      Creating a fresh local branch from origin/${default_branch} as requested." >&2
    fi
    echo "==> Creating branch '${branch}' from origin/${default_branch}"
    # --no-track: this is a fresh branch, not a copy that should push to the
    # default branch. Leave upstream unset until the user pushes it.
    git checkout -b "${branch}" --no-track "origin/${default_branch}"
  fi
}

print_clean_usage() {
  echo "Usage: ghpr clean [options]" >&2
  echo "" >&2
  echo "Remove work directories under ${base_dir} whose PR is merged or closed." >&2
  echo "Covers both PR checkout dirs (<repo>-pr<number>) and 'ghpr create' dirs" >&2
  echo "(<repo>-<branch>, matched to a PR by the dir's current branch)." >&2
  echo "Directories with uncommitted changes or stashes are always kept." >&2
  echo "" >&2
  echo "Options:" >&2
  echo "  -n, --dry-run   List deletion candidates without removing anything" >&2
  echo "  -y, --yes       Delete without the interactive confirmation prompt" >&2
  echo "      --days <N>  Also flag dirs not modified for N+ days (default: off)" >&2
  echo "  -h, --help      Show this help" >&2
}

# Parse "owner/repo" out of a git remote URL (https or ssh form).
parse_repo_slug() {
  local url="$1"
  if [[ "$url" =~ github\.com[:/]+([^/]+)/([^/]+) ]]; then
    local owner="${BASH_REMATCH[1]}"
    local name="${BASH_REMATCH[2]}"
    name="${name%.git}"
    printf '%s/%s\n' "$owner" "$name"
  fi
}

# Find an existing work dir that is a full, self-contained clone of <slug>, to
# seed a new work dir from. Prints its path, or nothing.
find_reference_repo() {
  local slug="$1" repo_name="${1##*/}" exclude="${2:-}"
  local want d url have
  want="$(printf '%s' "$slug" | tr '[:upper:]' '[:lower:]')"
  for d in "${base_dir}/${repo_name}"-*; do
    [ -d "$d/.git" ] || continue
    [ "$d" = "$exclude" ] && continue
    # Shallow / borrowed / partial object stores are not safe to copy from.
    [ -e "$d/.git/shallow" ] && continue
    [ -e "$d/.git/objects/info/alternates" ] && continue
    [ -n "$(git -C "$d" config --get-regexp '^remote\..*\.promisor$' 2>/dev/null || true)" ] && continue
    url="$(git -C "$d" remote get-url origin 2>/dev/null || true)"
    have="$(parse_repo_slug "$url" | tr '[:upper:]' '[:lower:]')"
    if [ "$have" = "$want" ]; then
      printf '%s\n' "$d"
      return 0
    fi
  done
  return 0
}

# git, authenticating to github.com the way gh's own git calls do, and never
# stopping to prompt (callers fall back to plain git / gh on failure).
gitgh() {
  GIT_TERMINAL_PROMPT=0 git \
    -c credential.https://github.com.helper= \
    -c 'credential.https://github.com.helper=!gh auth git-credential' "$@"
}

# Scratch file for the output of a background `gh` call.
GHPR_TMP=""
make_tmp() {
  GHPR_TMP="$(mktemp "${TMPDIR:-/tmp}/ghpr.XXXXXX")"
  trap 'rm -f "$GHPR_TMP"' EXIT
}

# Build <dest> from a sibling work dir of the same repo WITHOUT touching the
# network: `git clone --local` hardlinks the object store (instant, and safe
# when `ghpr clean` later deletes the sibling), then the sibling's own branches
# are dropped and its last-known origin/* (and upstream/*) refs and remote URLs
# are carried over.
# The result is NOT a finished clone: origin/* may be stale and there is no
# local branch or working tree. The caller must fetch with --prune and then
# call seed_finish. Returns 1 (leaving no <dest>) when there is no usable sibling.
seed_clone() {
  local slug="$1" dest="$2" ref url r rurl resolved
  ref="$(find_reference_repo "$slug" "$dest")"
  [ -n "$ref" ] || return 1
  url="$(git -C "$ref" remote get-url origin 2>/dev/null || true)"
  [ -n "$url" ] || return 1

  echo "==> Seeding from $(basename "$ref") (local copy, no download)"
  if git clone -q --local --no-checkout --origin ghpr-seed "$ref" "$dest" 2>/dev/null \
     && git -C "$dest" symbolic-ref HEAD refs/heads/ghpr-seed-unborn \
     && { git -C "$dest" for-each-ref --format='delete %(refname)' refs/heads
          git -C "$ref" for-each-ref --format='%(symref)|create %(refname) %(objectname)' \
              refs/remotes/origin refs/remotes/upstream | sed -n 's/^|//p'
        } | git -C "$dest" update-ref --stdin \
     && git -C "$dest" remote remove ghpr-seed \
     && git -C "$dest" remote add origin "$url"; then
    # gh repo clone gives forks an "upstream" remote; keep it if the sibling has one.
    for r in upstream; do
      rurl="$(git -C "$ref" remote get-url "$r" 2>/dev/null || true)"
      [ -n "$rurl" ] || continue
      git -C "$dest" remote add "$r" "$rurl" 2>/dev/null || true
      resolved="$(git -C "$ref" config --get "remote.${r}.gh-resolved" 2>/dev/null || true)"
      [ -n "$resolved" ] && git -C "$dest" config "remote.${r}.gh-resolved" "$resolved"
    done
    r="$(git -C "$ref" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null || true)"
    [ -n "$r" ] && git -C "$dest" symbolic-ref refs/remotes/origin/HEAD "$r" 2>/dev/null || true
    return 0
  fi
  rm -rf "$dest"
  return 1
}

# Second half of seed_clone, run in the seeded repo after its fetch: point
# origin/HEAD at the default branch and create the local default branch, so the
# repo looks like a `git clone --no-checkout` made just now.
# $1 = default branch name if known (else the carried-over origin/HEAD is used).
seed_finish() {
  local d="${1:-}"
  if [ -n "$d" ] && git show-ref --verify --quiet "refs/remotes/origin/${d}"; then
    git remote set-head origin "$d" >/dev/null 2>&1 || true
  else
    d="$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    d="${d#origin/}"
  fi
  [ -n "$d" ] || return 0
  git show-ref --verify --quiet "refs/remotes/origin/${d}" || return 0
  git show-ref --verify --quiet "refs/heads/${d}" \
    || git branch -q --track "$d" "origin/${d}" >/dev/null 2>&1 || return 0
  git symbolic-ref HEAD "refs/heads/${d}"
}

# Clone <slug> into <dest> with no working tree (every caller checks out its
# own branch right away, or restores the default one on failure).
# Seeds from a sibling work dir when possible (no network; sets CLONE_SEEDED=1
# so the caller knows it still has to fetch and seed_finish), else gh repo clone.
CLONE_SEEDED=0
clone_repo() {
  local slug="$1" dest="$2"
  CLONE_SEEDED=0
  if seed_clone "$slug" "$dest"; then
    CLONE_SEEDED=1
    return 0
  fi
  gh repo clone "$slug" "$dest" -- --no-checkout
}

# Check out PR <number> of <owner/repo> in the current repo, doing what
# `gh pr checkout` does for a same-repo PR (local branch named after the PR's
# head branch, tracking origin/<branch>, fast-forwarded) but with the PR lookup
# and the git fetch running at the same time instead of one after the other.
# Also completes a seeded clone (CLONE_SEEDED=1).
# Returns 1 when the PR is not a plain same-repo PR or anything goes wrong; the
# caller then runs `gh pr checkout`, so gh stays the source of truth.
fast_pr_checkout() {
  local number="$1" repo="$2"
  local fetched=0 info_pid="" base_repo="" head_repo="" default_branch="" head_ref="" current

  if [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    make_tmp
    gh api "repos/${repo}/pulls/${number}" \
      --jq '[.base.repo.full_name, (.head.repo.full_name // ""), .base.repo.default_branch, .head.ref] | join(":")' \
      >"$GHPR_TMP" 2>/dev/null &
    info_pid=$!
  fi

  if [ "$CLONE_SEEDED" -eq 1 ]; then
    if gitgh fetch -q --prune origin 2>/dev/null || git fetch --prune origin; then fetched=1; fi
  else
    if gitgh fetch -q origin 2>/dev/null; then fetched=1; fi
  fi

  if [ -n "$info_pid" ]; then
    wait "$info_pid" || true
    IFS=: read -r base_repo head_repo default_branch head_ref <"$GHPR_TMP" || true
  fi

  [ "$CLONE_SEEDED" -eq 1 ] && seed_finish "$default_branch"

  [ "$fetched" -eq 1 ] || return 1
  { [ -n "$head_ref" ] && [ -n "$base_repo" ] && [ "$head_repo" = "$base_repo" ]; } || return 1
  git show-ref --verify --quiet "refs/remotes/origin/${head_ref}" || return 1

  if git show-ref --verify --quiet "refs/heads/${head_ref}"; then
    current="$(git symbolic-ref -q --short HEAD 2>/dev/null || true)"
    if [ "$current" != "$head_ref" ] || [ ! -e "$(git rev-parse --git-dir)/index" ]; then
      git checkout -q "$head_ref" 2>/dev/null || return 1
    fi
    git merge -q --ff-only "refs/remotes/origin/${head_ref}" 2>/dev/null || return 1
  else
    git checkout -q -b "$head_ref" --track "origin/${head_ref}" 2>/dev/null || return 1
  fi
  echo "==> Checked out PR #${number} on branch '${head_ref}'"
}

# Return 0 (true) if the repo has work that could be lost on deletion.
workdir_is_dirty() {
  local dir="$1"
  # Uncommitted changes (staged, unstaged, or untracked).
  if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
    return 0
  fi
  # Stashed work.
  if [ -n "$(git -C "$dir" stash list 2>/dev/null)" ]; then
    return 0
  fi
  return 1
}

# Return 0 (true) if the current HEAD commit exists on some remote-tracking
# branch (i.e. it has been pushed somewhere). Used to protect a `ghpr create`
# branch whose commits are local-only from being deleted.
branch_is_pushed() {
  local dir="$1"
  [ -n "$(git -C "$dir" branch -r --contains HEAD 2>/dev/null)" ]
}

# Resolve the PR state for a `ghpr create` work dir by looking up the PR whose
# head is the dir's current branch. Prints "STATE\tNUMBER\tTITLE" for the most
# relevant PR (an OPEN one wins; else MERGED; else CLOSED), or nothing when the
# branch has no PR at all. $2 receives the resolved branch name back.
resolve_create_pr() {
  local dir="$1" slug="$2"
  local branch
  branch="$(git -C "$dir" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  printf '%s\n' "$branch"   # first line: branch (empty if detached)
  [ -z "$branch" ] && return 0

  local prlist
  prlist="$(gh pr list --repo "$slug" --head "$branch" --state all \
              --json number,state,title \
              --jq '.[] | .state + "\t" + (.number|tostring) + "\t" + .title' \
              2>/dev/null || true)"
  [ -z "$prlist" ] && return 0

  local line pstate pnum ptitle
  local pick_state="" pick_num="" pick_title=""
  while IFS=$'\t' read -r pstate pnum ptitle; do
    [ -z "$pstate" ] && continue
    if [ "$pstate" = "OPEN" ]; then
      pick_state="OPEN"; pick_num="$pnum"; pick_title="$ptitle"; break
    fi
    if [ -z "$pick_state" ] || { [ "$pstate" = "MERGED" ] && [ "$pick_state" = "CLOSED" ]; }; then
      pick_state="$pstate"; pick_num="$pnum"; pick_title="$ptitle"
    fi
  done <<<"$prlist"

  printf '%s\t%s\t%s\n' "$pick_state" "$pick_num" "$pick_title"
}

clean_workdirs() {
  local dry_run=0 assume_yes=0 days=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--dry-run) dry_run=1 ;;
      -y|--yes) assume_yes=1 ;;
      --days)
        shift
        if [ $# -eq 0 ] || ! [[ "${1:-}" =~ ^[0-9]+$ ]]; then
          echo "Error: --days requires a number" >&2
          return 1
        fi
        days="$1"
        ;;
      -h|--help) print_clean_usage; return 0 ;;
      *) echo "Error: unknown option for clean: $1" >&2; print_clean_usage; return 1 ;;
    esac
    shift
  done

  if [ ! -d "$base_dir" ]; then
    echo "No work directory found: ${base_dir} (nothing to clean)"
    return 0
  fi

  if ! command -v gh &>/dev/null; then
    echo "Error: GitHub CLI (gh) is required for 'ghpr clean'" >&2
    echo "Install it from: https://cli.github.com/" >&2
    return 1
  fi

  echo "==> Scanning ${base_dir} for cleanup candidates..."

  local to_delete=()    # "dir|repo #pr|state|title"
  local skipped=()      # "dir|reason"
  local kept=()         # "dir|state"
  local unknown=()      # "dir|reason"

  # Scan every work dir. Two naming schemes are handled:
  #   <repo>-pr<number>   PR checkout dir  -> look the PR up by number
  #   <repo>-<branch>     `ghpr create` dir -> look the PR up by head branch
  local dir name remote_url repo_slug state title pr_label reason is_create
  shopt -s nullglob
  for dir in "$base_dir"/*; do
    [ -d "$dir" ] || continue
    name="$(basename "$dir")"

    if [ ! -d "$dir/.git" ]; then
      unknown+=("${name}|not a git repository")
      continue
    fi

    remote_url="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
    repo_slug="$(parse_repo_slug "$remote_url")"
    if [ -z "$repo_slug" ]; then
      unknown+=("${name}|no GitHub remote found")
      continue
    fi

    state=""; title=""; pr_label=""; is_create=0
    if [[ "$name" =~ -pr([0-9]+)$ ]]; then
      # ----- PR checkout dir -----
      local pr_number="${BASH_REMATCH[1]}"
      pr_label="#${pr_number}"
      local info
      info="$(gh pr view "$pr_number" --repo "$repo_slug" --json state,title --jq '.state + "\t" + .title' 2>/dev/null || true)"
      if [ -z "$info" ]; then
        unknown+=("${name}|could not fetch PR ${repo_slug}#${pr_number}")
        continue
      fi
      state="${info%%$'\t'*}"
      title="${info#*$'\t'}"
    else
      # ----- `ghpr create` dir: resolve the PR from the current branch -----
      is_create=1
      local resolved branch pr_line pick_state pick_num pick_title
      resolved="$(resolve_create_pr "$dir" "$repo_slug")"
      branch="$(printf '%s\n' "$resolved" | sed -n '1p')"
      pr_line="$(printf '%s\n' "$resolved" | sed -n '2p')"
      if [ -z "$branch" ]; then
        unknown+=("${name}|detached HEAD (no branch)")
        continue
      fi
      if [ -z "$pr_line" ]; then
        unknown+=("${name}|no PR for branch '${branch}' (local-only)")
        continue
      fi
      IFS=$'\t' read -r pick_state pick_num pick_title <<<"$pr_line"
      state="$pick_state"
      title="$pick_title"
      pr_label="#${pick_num} (branch ${branch})"
    fi

    local stale=0
    if [ "$days" -gt 0 ]; then
      if [ -z "$(find "$dir" -maxdepth 0 -mtime -"$days" 2>/dev/null)" ]; then
        stale=1
      fi
    fi

    if [ "$state" = "MERGED" ] || [ "$state" = "CLOSED" ] || [ "$stale" -eq 1 ]; then
      reason=""
      if workdir_is_dirty "$dir"; then
        reason="uncommitted changes or stashes"
      elif [ "$is_create" -eq 1 ] && [ "$state" = "CLOSED" ] && ! branch_is_pushed "$dir"; then
        # A closed (not merged) create branch whose commits live only here:
        # keep it so the local work is never lost.
        reason="closed PR, local commits not pushed"
      fi
      if [ -n "$reason" ]; then
        skipped+=("${name}|${state} ${repo_slug}${pr_label:+ ${pr_label}} (${reason})")
      else
        to_delete+=("${dir}|${repo_slug} ${pr_label}|${state}|${title}")
      fi
    else
      kept+=("${name}|${state} ${repo_slug} ${pr_label}")
    fi
  done

  # ----- Report -----
  local delete_label="PR merged/closed"
  [ "$days" -gt 0 ] && delete_label="PR merged/closed or not modified for ${days}+ days"
  echo ""
  if [ "${#to_delete[@]}" -gt 0 ]; then
    echo "To delete (${delete_label}):"
    local entry d slug st tt
    for entry in "${to_delete[@]}"; do
      IFS='|' read -r d slug st tt <<<"$entry"
      printf '  [%s] %-40s %s  %s\n' "$st" "$(basename "$d")" "$slug" "$tt"
    done
    echo ""
  fi
  if [ "${#skipped[@]}" -gt 0 ]; then
    echo "Skipped (local work would be lost):"
    local s
    for s in "${skipped[@]}"; do printf '  %s\n' "${s/|/  }"; done
    echo ""
  fi
  if [ "${#unknown[@]}" -gt 0 ]; then
    echo "Unknown (PR state undetermined, kept):"
    local u
    for u in "${unknown[@]}"; do printf '  %s\n' "${u/|/  }"; done
    echo ""
  fi
  if [ "${#kept[@]}" -gt 0 ]; then
    echo "Kept (PR still open):"
    local k
    for k in "${kept[@]}"; do printf '  %s\n' "${k/|/  }"; done
    echo ""
  fi

  if [ "${#to_delete[@]}" -eq 0 ]; then
    echo "Nothing to delete."
    return 0
  fi

  # Total size of deletion candidates.
  local total_size paths=()
  local entry d
  for entry in "${to_delete[@]}"; do
    d="${entry%%|*}"
    paths+=("$d")
  done
  total_size="$(du -sh -c "${paths[@]}" 2>/dev/null | tail -1 | cut -f1 || true)"

  echo "${#to_delete[@]} directory(ies) to delete${total_size:+ (~${total_size})}."

  if [ "$dry_run" -eq 1 ]; then
    echo "(dry-run) No directories were removed."
    return 0
  fi

  if [ "$assume_yes" -ne 1 ]; then
    local answer
    printf "Proceed with deletion? [y/N] "
    read -r answer || answer=""
    case "$answer" in
      y|Y|yes|YES) ;;
      *) echo "Aborted. No directories were removed."; return 0 ;;
    esac
  fi

  local removed=0
  for d in "${paths[@]}"; do
    echo "  removing ${d}"
    rm -rf "$d"
    removed=$((removed + 1))
  done
  echo "==> Removed ${removed} directory(ies)."
}

# ---- Subcommand dispatch ----
if [ $# -ge 1 ] && { [ "$1" = "update" ] || [ "$1" = "self-update" ] || [ "$1" = "upgrade" ]; }; then
  update_self
  exit $?
fi

if [ $# -ge 1 ] && [ "$1" = "create" ]; then
  shift
  create_branch "$@"
  exit $?
fi

if [ $# -ge 1 ] && { [ "$1" = "clean" ] || [ "$1" = "prune" ]; }; then
  shift
  clean_workdirs "$@"
  exit 0
fi

# Parse arguments - support both URL and separate arguments
if [ $# -eq 1 ]; then
  # Single argument - assume it's a GitHub PR URL
  url="$1"
  if [[ "$url" =~ ^https?://github\.com/([^/]+/[^/]+)/pull/([0-9]+) ]]; then
    repo="${BASH_REMATCH[1]}"
    pr_number="${BASH_REMATCH[2]}"
  else
    echo "Error: Invalid GitHub PR URL format" >&2
    echo "Expected: https://github.com/owner/repo/pull/<number>" >&2
    echo "" >&2
    print_usage
    exit 1
  fi
elif [ $# -eq 2 ]; then
  # Two arguments - original format
  pr_number="$1"
  repo="$2"
else
  print_usage
  exit 1
fi

mkdir -p "${base_dir}"

repo_name="${repo##*/}"
work_dir="${base_dir}/${repo_name}-pr${pr_number}"

echo "==> Use workdir: ${work_dir}"

fresh_clone=0
CLONE_SEEDED=0
if [ ! -d "${work_dir}/.git" ]; then
  echo "==> No git repo found in ${work_dir}. Cloning..."
  rm -rf "${work_dir}"
  cd "${base_dir}"
  clone_repo "${repo}" "${work_dir}"
  fresh_clone=1
else
  echo "==> Existing git repo found in ${work_dir}"
fi

cd "${work_dir}"

if ! fast_pr_checkout "${pr_number}" "${repo}"; then
  echo "==> Running: gh pr checkout ${pr_number} --repo ${repo}"
  if ! gh pr checkout "${pr_number}" --repo "${repo}"; then
    # The clone was made without a working tree; give it the default branch's
    # files so a failed checkout leaves an ordinary clone behind.
    [ "$fresh_clone" -eq 1 ] && git reset -q --hard 2>/dev/null || true
    exit 1
  fi
fi
